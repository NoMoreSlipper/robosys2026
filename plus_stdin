import sys

x = 0.0
for line in sys.stdin:      #plus_bのsys.argv[1:]をsys.stdinに変えただけ
  try:
    x += int(line)    #intは文字列を整数に（失敗すると例外発生）
  except ValueError:    #第3回で見たエラーの名前
    x += float(line)

print(x)
